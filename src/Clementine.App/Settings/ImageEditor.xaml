<Window x:Class="Clementine.App.Settings.ImageEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="980" Height="720" MinWidth="640" MinHeight="480" Topmost="True"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <!-- proporzioni (Ritaglia) oppure strumenti e colori (Annota) -->
            <WrapPanel x:Name="Options" />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <TextBlock x:Name="Info" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Annulla" MinWidth="90" Padding="8,4" Margin="8,0,0,0" IsCancel="True" />
                <Button x:Name="OkButton" DockPanel.Dock="Right" MinWidth="90" Padding="8,4" IsDefault="True" Click="Ok_Click" />
                <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="↶ Togli l'ultimo" Padding="8,4" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="Undo_Click" ToolTip="Ctrl+Z" />
            </DockPanel>
            <TextBlock x:Name="Hint" Opacity="0.6" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <!-- il Viewbox adatta la foto alla finestra: le coordinate della Canvas restano i pixel dell'anteprima -->
        <Viewbox>
            <Grid x:Name="Stage">
                <Image x:Name="Picture" Stretch="Fill" />
                <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True" Cursor="Cross"
                        MouseLeftButtonDown="Overlay_Down" MouseMove="Overlay_Move" MouseLeftButtonUp="Overlay_Up" />
            </Grid>
        </Viewbox>
    </DockPanel>
</Window>
