<Window x:Class="Clementine.App.Settings.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Clementine.App"
        Title="{app:T 'Benvenuto in Clementine', 'Welcome to Clementine'}" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <StackPanel Margin="28,24">
        <DockPanel Margin="0,0,0,18">
            <Image Source="/Assets/Clementine.ico" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{app:T 'Benvenuto in Clementine', 'Welcome to Clementine'}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
        </DockPanel>

        <TextBlock FontWeight="SemiBold" Text="{app:T 'Trascina i file sull\'arancia', 'Drag files onto the orange'}" />
        <TextBlock TextWrapping="Wrap" Margin="0,2,0,14" Opacity="0.8"
                   Text="{app:T 'Si apre una ruota: rilascia sullo spicchio che ti serve. Il risultato compare accanto all\'originale, che non viene mai toccato.', 'A wheel opens: drop on the slice you need. The result appears next to the original, which is never touched.'}" />

        <TextBlock FontWeight="SemiBold" Text="{app:T 'Ctrl e Alt cambiano la ruota', 'Ctrl and Alt change the wheel'}" />
        <TextBlock TextWrapping="Wrap" Margin="0,2,0,14" Opacity="0.8"
                   Text="{app:T 'Mentre trascini, Ctrl mostra gli strumenti (comprimi, per il web, unisci…), Alt le azioni (copia, sposta, condividi…). Senza tastiera: fermati un attimo sul centro della ruota.', 'While dragging, Ctrl shows the tools (compress, for the web, merge…) and Alt the actions (copy, move, share…). No keyboard? Pause for a moment on the centre of the wheel.'}" />

        <TextBlock FontWeight="SemiBold" Text="{app:T 'Oppure clic destro su un file', 'Or right-click a file'}" />
        <TextBlock TextWrapping="Wrap" Margin="0,2,0,14" Opacity="0.8"
                   Text="{app:T 'In Esplora file: Mostra altre opzioni → Clementine.', 'In File Explorer: Show more options → Clementine.'}" />

        <TextBlock FontWeight="SemiBold" Text="{app:T 'Clic sull\'arancia', 'Click the orange'}" />
        <TextBlock TextWrapping="Wrap" Margin="0,2,0,22" Opacity="0.8"
                   Text="{app:T 'Ultimi file, converti dagli appunti, impostazioni. Puoi spostarla dove vuoi: sul bordo dello schermo si nasconde e riappare al passaggio del mouse.', 'Recent files, convert from the clipboard, settings. You can move it anywhere: at the edge of the screen it hides and comes back when the mouse passes over it.'}" />

        <Button Content="{app:T 'Inizia', 'Get started'}" HorizontalAlignment="Right" MinWidth="100" Padding="0,5" IsDefault="True" IsCancel="True" Click="Start_Click" />
    </StackPanel>
</Window>
