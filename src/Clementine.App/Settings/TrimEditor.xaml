<Window x:Class="Clementine.App.Settings.TrimEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taglia" Width="820" Height="600" MinWidth="560" MinHeight="420" Topmost="True"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <!-- la parte tenuta è evidenziata sulla barra (SelectionStart/End) -->
            <Slider x:Name="Timeline" IsSelectionRangeEnabled="True" IsMoveToPointEnabled="True" />
            <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="Position" DockPanel.Dock="Left" VerticalAlignment="Center" FontFamily="Consolas" />
                <TextBlock x:Name="Selection" DockPanel.Dock="Right" VerticalAlignment="Center" />
                <TextBlock />
            </DockPanel>
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button x:Name="PlayButton" Content="▶  Riproduci" MinWidth="120" Padding="8,4" Click="Play_Click" />
                <Button Content="⟨ Inizio qui" MinWidth="110" Padding="8,4" Margin="8,0,0,0" Click="Start_Click"
                        ToolTip="La parte tenuta comincia dal punto attuale (tasto I)" />
                <Button Content="Fine qui ⟩" MinWidth="110" Padding="8,4" Margin="8,0,0,0" Click="End_Click"
                        ToolTip="La parte tenuta finisce al punto attuale (tasto O)" />
                <Button DockPanel.Dock="Right" Content="Annulla" MinWidth="90" Padding="8,4" Margin="8,0,0,0" IsCancel="True" />
                <Button DockPanel.Dock="Right" Content="Taglia" MinWidth="90" Padding="8,4" IsDefault="True" Click="Ok_Click" />
            </DockPanel>
            <TextBlock Opacity="0.6" FontSize="12" Margin="0,8,0,0"
                       Text="Spazio: riproduci/pausa · ← →: un fotogramma · Maiusc+← →: un secondo · I / O: inizio / fine" />
        </StackPanel>
        <Border Background="Black">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" />
        </Border>
    </DockPanel>
</Window>
