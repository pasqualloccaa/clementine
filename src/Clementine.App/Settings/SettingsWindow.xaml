<Window x:Class="Clementine.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni di Clementine" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <StackPanel Margin="24,20" MinWidth="420">
        <CheckBox x:Name="AutostartBox" Content="Avvia Clementine all'accensione del computer" Margin="0,0,0,10" />
        <CheckBox x:Name="ExplorerMenuBox" Content="Voci di Clementine nel clic destro di Esplora file" Margin="0,0,0,18" />

        <TextBlock Text="LibreOffice" FontWeight="SemiBold" />
        <TextBlock x:Name="LibreOfficeText" TextWrapping="Wrap" MaxWidth="420" Margin="0,2,0,18" Foreground="#555" />

        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                <Hyperlink x:Name="LogsLink">Apri la cartella dei log</Hyperlink>
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="Chiudi" MinWidth="90" Padding="0,4" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </DockPanel>
    </StackPanel>
</Window>
