<Window x:Class="Clementine.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Clementine.App"
        Title="{app:T 'Impostazioni di Clementine', 'Clementine settings'}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <StackPanel Margin="24,20" MinWidth="420">
        <CheckBox x:Name="AutostartBox" Content="{app:T 'Avvia Clementine all\'accensione del computer', 'Start Clementine when the computer starts'}" Margin="0,0,0,10" />
        <CheckBox x:Name="ExplorerMenuBox" Content="{app:T 'Voci di Clementine nel clic destro di Esplora file', 'Clementine entries in the File Explorer right-click menu'}" Margin="0,0,0,18" />

        <TextBlock Text="{app:T 'Lingua', 'Language'}" FontWeight="SemiBold" />
        <StackPanel x:Name="LanguageChoices" Orientation="Horizontal" Margin="0,4,0,18">
            <RadioButton Tag="auto" Content="{app:T 'Come Windows', 'Same as Windows'}" Margin="0,0,16,0" />
            <RadioButton Tag="it" Content="Italiano" Margin="0,0,16,0" />
            <RadioButton Tag="en" Content="English" />
        </StackPanel>

        <TextBlock Text="LibreOffice" FontWeight="SemiBold" />
        <TextBlock x:Name="LibreOfficeText" TextWrapping="Wrap" MaxWidth="420" Margin="0,2,0,18" Opacity="0.7" />

        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                <Hyperlink x:Name="LogsLink"><Run Text="{app:T 'Apri la cartella dei log', 'Open the logs folder'}" /></Hyperlink>
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="{app:T 'Chiudi', 'Close'}" MinWidth="90" Padding="0,4" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </DockPanel>
    </StackPanel>
</Window>
