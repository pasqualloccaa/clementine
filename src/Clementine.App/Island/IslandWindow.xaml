<Window x:Class="Clementine.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clementine" Width="56" Height="56"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" AllowDrop="True">
    <Grid>
        <Grid x:Name="IslandView" Width="56" Height="56" Cursor="Hand"
              MouseLeftButtonDown="Island_MouseLeftButtonDown">
            <Ellipse Margin="3">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                        <GradientStop Color="#FFFFB74D" Offset="0" />
                        <GradientStop Color="#FFF57C00" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="16" Height="8" Fill="#FF2E7D32" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="14,3,0,0" RenderTransformOrigin="0,1">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-25" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- anello di avanzamento: StrokeDashArray impostato da SetProgress; parte dalle ore 12 -->
            <Ellipse x:Name="ProgressRing" Margin="3" Stroke="White" StrokeThickness="3" Visibility="Collapsed"
                     IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <Canvas x:Name="WheelCanvas" Width="300" Height="300" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <ScaleTransform x:Name="WheelScale" />
            </Canvas.RenderTransform>
            <!-- disco opaco: senza riempimento la finestra trasparente non riceverebbe il drag -->
            <Ellipse Width="300" Height="300" Fill="#E61E1E1E" />
            <Ellipse Canvas.Left="122" Canvas.Top="122" Width="56" Height="56" Fill="#FFF57C00" />
        </Canvas>
    </Grid>
</Window>
